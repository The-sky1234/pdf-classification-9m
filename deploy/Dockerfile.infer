# 分类波次：bge-m3 + bge-reranker-v2-m3。torch 的 cu121 wheel 自带 CUDA 运行库，基础镜像不需要 CUDA。
# 模型挂在 ${MODEL_DIR}/hf → /models/hf，运行时 HF_HUB_OFFLINE=1，不联网。
FROM python:3.11-slim-bookworm
ARG PIP_INDEX_URL=https://pypi.org/simple
ARG TORCH_INDEX_URL=https://download.pytorch.org/whl/cu121
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PIP_INDEX_URL=${PIP_INDEX_URL} \
    HOME=/home/app HF_HOME=/models/hf HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 && rm -rf /var/lib/apt/lists/*
WORKDIR /srv/app
COPY deploy/requirements-common.txt deploy/requirements-infer.txt ./deploy/
RUN pip install torch==2.4.1 --index-url ${TORCH_INDEX_URL} \
 && pip install -r deploy/requirements-infer.txt
COPY backend ./backend
COPY classifier ./classifier
COPY contracts ./contracts
COPY parser ./parser
COPY phase1 ./phase1
COPY scheduler ./scheduler
COPY deploy/fetch_models.py ./deploy/
RUN useradd -m -u 10001 app && chmod 1777 /home/app
USER app
CMD ["python", "-m", "phase1", "work", "--stage", "classify"]
