# 复制成 deploy/.env 再填写；ops.sh init 会把它改成 600 权限。.env 不要提交到仓库。

# ---- 数据库 ----
POSTGRES_DB=pdfcls
POSTGRES_USER=pdfcls
# 只用字母和数字：它会拼进连接串，@ : / # 之类的字符会把连接串截断
POSTGRES_PASSWORD=
# PostgreSQL 数据目录，放在 SSD 上；900 万行台账约 30-60GB
PG_DATA_DIR=/data/pdfcls/pgdata
# 按内存调：一般取内存的 1/4 和 3/4
PG_SHARED_BUFFERS=8GB
PG_EFFECTIVE_CACHE=24GB

# ---- API ----
# 调用 /phase1/* 时带 X-API-Key 请求头；生成：openssl rand -hex 24
API_KEY=
# 默认只在本机监听；要给内网复核页面用，改成服务器内网 IP
API_BIND=127.0.0.1
API_PORT=8000

# ---- 目录（宿主机路径，会按原路径挂进容器）----
# 源文件根目录，只读挂载。主件清单里的路径都必须在它下面（不在就用 load --map 换前缀）
SOURCE_ROOT=/mnt/nas/source
# 归档根目录，不能在 SOURCE_ROOT 里面；空间至少要装下全部主件
ARCHIVE_ROOT=/data/archive
# 锁、导出、备份、阈值配置
DATA_DIR=/data/pdfcls
# 模型缓存：paddleocr/ 约 20MB，hf/ 约 4.5GB
MODEL_DIR=/data/pdfcls/models
# 容器里跑任务的用户，要能读 SOURCE_ROOT、写 ARCHIVE_ROOT
APP_UID=10001
APP_GID=10001

# ---- 并发 ----
# CPU 波次进程数，取 CPU 核数减 4 左右
CPU_PROCS=16
# OCR 进程数，每个约占 2-4GB 显存；A6000 上 3-4 个
OCR_PROCS=3
OCR_DPI=200
# 分类进程数，每个加载一份 bge-m3 + reranker（fp16 约 3GB）
CLASSIFY_PROCS=1
GPU_DEVICE=0

# ---- 分类 ----
# Hugging Face 模型名（从 MODEL_DIR/hf 离线加载），一般不用改
EMBED_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3
# 阈值文件放在 DATA_DIR/config/ 下，这里写容器内路径 /config/xxx.json。
# 留空 = 未校准：分类结果一律进 04_待复核暂存，不会自动进业务目录。
THRESHOLDS_FILE=
# ---- 大模型兜底（可选）----
# 向量 + 重排拿不准的文件，再让大模型在候选里选一个；它也拿不准就转人工复核。
# 不用：LLM_MODEL 留空或 LLM_MAX_CALLS=0（默认），拿不准的全部转人工复核。
# 用本机部署（推荐，数据不出服务器）：LLM_MODEL=Qwen/Qwen2.5-7B-Instruct，LLM_MAX_CALLS 设成正数，LLM_ENDPOINT 留空。
#   ops.sh fetch-models 会下载它（约 15GB），ops.sh wave classify 会先起 vLLM 再起分类，OCR 波次时自动停掉。
#   显存：7B 约占 LLM_GPU_UTIL × 48GB ≈ 19GB，和分类模型同时运行没问题。
#   想更准可换 Qwen/Qwen2.5-14B-Instruct-AWQ（同样约 19GB 档）。
# 用外部服务：填 LLM_ENDPOINT（OpenAI 兼容地址，宿主机上的写 http://host.docker.internal:端口/v1）和 LLM_API_KEY。
#   云端接口会把文件内容发到外部，有保密要求的不要用。
# 不要用 Qwen3、DeepSeek-R1 这类带思考的模型；非用不可就把 LLM_MAX_TOKENS 调到 1024 以上（会慢很多）。
LLM_MODEL=
# 每个分类进程从启动起最多调用多少次，用完后拿不准的转人工复核
LLM_MAX_CALLS=0
LLM_ENDPOINT=
LLM_API_KEY=
LLM_GPU_UTIL=0.40
LLM_MAX_TOKENS=32
VLLM_TAG=v0.6.6.post1

# ---- 构建与下载 ----
# 国内可换 https://pypi.tuna.tsinghua.edu.cn/simple
PIP_INDEX_URL=https://pypi.org/simple
# 国内可换 https://hf-mirror.com（只在 fetch-models 时用）
HF_ENDPOINT=https://huggingface.co
IMAGE_TAG=latest
LOG_LEVEL=INFO
