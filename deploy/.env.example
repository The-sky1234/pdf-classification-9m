# 复制为 .env（永不提交），所有密码/密钥只来自环境
POSTGRES_DB=pdfcls
POSTGRES_USER=pdfcls
POSTGRES_PASSWORD=CHANGE_ME_32CHAR_RANDOM
API_KEY=CHANGE_ME_API_KEY
DATABASE_URL=
API_PORT=8000
API_URL=http://api:8000
THRESHOLDS_CALIBRATED=0
# 宿主机PDF根目录（容器内只读挂载 /data/pdfs）
PDF_ROOT_HOST=/mnt/pdfs
CPU_WORKERS=8
REDIS_MAXMEMORY=4gb
# GPU 写死：1 张 NVIDIA RTX A6000 48GB，设备号 0。Compose 不再读取卡号变量。
BGE_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
LLM_ENDPOINT=http://gpu-llm:8001/v1
LLM_API_KEY=CHANGE_ME_LLM_KEY
PROM_PORT=9090
