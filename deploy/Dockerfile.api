# API + CPU worker：不含任何GPU依赖
FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /srv/app
COPY backend/requirements.txt ./backend-req.txt
COPY parser/requirements.txt ./parser-req.txt
RUN pip install -r backend-req.txt -r parser-req.txt
COPY backend ./backend
COPY parser ./parser
COPY classifier ./classifier
COPY contracts ./contracts
COPY registry ./registry
COPY dedup ./dedup
COPY exclusion ./exclusion
COPY archive ./archive
COPY scheduler ./scheduler
COPY deploy/worker_main.py ./deploy_worker_main.py
RUN useradd -m -u 10001 app && chown -R app /srv/app
USER app
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
  CMD python -c "import os,urllib.request; r=urllib.request.Request('http://127.0.0.1:8000/taxonomy', headers={'X-API-Key': os.environ.get('API_KEY','')}); urllib.request.urlopen(r, timeout=5)"
CMD ["uvicorn", "backend.app:get_app", "--factory", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
