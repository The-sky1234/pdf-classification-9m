# API、CPU 波次（抽文字 + 规则）、归档。不含任何 GPU 依赖。
FROM python:3.11-slim-bookworm
ARG PIP_INDEX_URL=https://pypi.org/simple
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PIP_INDEX_URL=${PIP_INDEX_URL} \
    HOME=/home/app
WORKDIR /srv/app
COPY deploy/requirements-common.txt deploy/requirements-api.txt ./deploy/
RUN pip install -r deploy/requirements-api.txt
COPY backend ./backend
COPY classifier ./classifier
COPY contracts ./contracts
COPY parser ./parser
COPY phase1 ./phase1
COPY scheduler ./scheduler
RUN useradd -m -u 10001 app && chmod 1777 /home/app
USER app
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/healthz', timeout=5)"
CMD ["uvicorn", "backend.app:get_app", "--factory", "--host", "0.0.0.0", "--port", "8000"]
